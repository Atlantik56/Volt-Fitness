DATA_DIR=./data

# Web Push (evening workout reminder) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
REMINDER_TZ=Europe/Moscow
REMINDER_HOUR=19
ANTHROPIC_API_KEY=
# Set to false to skip Anthropic in Auto and disable provider calls server-side.
ANTHROPIC_ENABLED=true
MWS_API_KEY=
MWS_PROJECT=
MWS_MODEL=

# Strava OAuth (read-only activity import)
# Register an app at https://www.strava.com/settings/api and set its callback
# domain to localhost for local development (or your HTTPS production domain).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
# Generate once with: openssl rand -base64 32
STRAVA_TOKEN_ENCRYPTION_KEY=
# Default is activity:read. Use activity:read_all only when private activities
# are required, then reconnect so Strava can ask for the expanded permission.
STRAVA_ACTIVITY_SCOPE=activity:read
# Random secrets used only by the public verification callback and the private
# retry/retention drain endpoint. Generate each independently.
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_PROCESS_TOKEN=
# Fill after Strava returns the Event Subscription id.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
# Public HTTPS endpoint registered in the Strava Developer Portal.
STRAVA_WEBHOOK_CALLBACK_URL=https://example.com/api/strava/webhook
